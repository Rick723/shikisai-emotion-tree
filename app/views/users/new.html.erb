<% content_for :title, "新規登録 | Shikisai 〜感情の木〜" %>

<main class="auth-page">
  <div class="container auth-page__container">
    <header class="auth-page__header">
      <p class="site-brand auth-page__brand">
        <span class="site-brand__name">Shikisai</span>
        <span class="site-brand__description">〜感情の木〜</span>
      </p>

      <%= link_to "← 戻る", root_path, class: "auth-page__back" %>
    </header>

    <section class="auth-panel" aria-labelledby="signup-title">
      <div class="auth-panel__heading">
        <p class="section-kicker">Create your account</p>
        <h1 id="signup-title" class="auth-panel__title">新規登録</h1>
      </div>

      <div class="auth-fields">
        <div class="auth-field">
          <label for="user-name" class="auth-field__label">ユーザー名</label>
          <input id="user-name" class="auth-field__input" type="text" maxlength="20">
          <p class="auth-field__hint">20文字以内</p>
        </div>

        <div class="auth-field">
          <label for="user-email" class="auth-field__label">メールアドレス</label>
          <input id="user-email" class="auth-field__input" type="email" autocomplete="email" inputmode="email">
        </div>

        <div class="auth-field">
          <label for="user-password" class="auth-field__label">パスワード</label>
          <input id="user-password" class="auth-field__input" type="password" autocomplete="new-password">
          <p class="auth-field__hint">8文字以上</p>
        </div>

        <div class="auth-field">
          <label for="user-password-confirmation" class="auth-field__label">パスワード（確認）</label>
          <input id="user-password-confirmation" class="auth-field__input" type="password" autocomplete="new-password">
        </div>
      </div>

      <button type="button" class="button button--primary button--disabled auth-panel__submit" disabled>
        登録する
      </button>
    </section>
  </div>
</main>
