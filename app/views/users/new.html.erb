<% content_for :title, "新規登録 | Shikisai 〜感情の木〜" %>

<main class="auth-page">
  <div class="container auth-page__container">
    <header class="auth-page__header">
      <p class="site-brand auth-page__brand">
        <span class="site-brand__name">Shikisai</span>
        <span class="site-brand__description">〜感情の木〜</span>
      </p>

      <%= link_to "← 戻る", root_path, class: "auth-page__back" %>
    </header>

    <section class="auth-panel" aria-labelledby="signup-title">
      <div class="auth-panel__heading">
        <p class="section-kicker">Create your account</p>
        <h1 id="signup-title" class="auth-panel__title">新規登録</h1>
      </div>

      <% if @user.errors.any? %>
        <div role="alert">
          <ul>
            <% @user.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @user do |form| %>
        <div class="auth-fields">
          <div class="auth-field">
            <%= form.label :name, "ユーザー名", for: "user-name", class: "auth-field__label" %>
            <%= form.text_field :name, id: "user-name", class: "auth-field__input", maxlength: 20, required: true %>
            <p class="auth-field__hint">20文字以内</p>
          </div>

          <div class="auth-field">
            <%= form.label :email, "メールアドレス", for: "user-email", class: "auth-field__label" %>
            <%= form.email_field :email, id: "user-email", class: "auth-field__input", autocomplete: "email", inputmode: "email", required: true %>
          </div>

          <div class="auth-field">
            <%= form.label :password, "パスワード", for: "user-password", class: "auth-field__label" %>
            <%= form.password_field :password, id: "user-password", class: "auth-field__input", autocomplete: "new-password", required: true %>
            <p class="auth-field__hint">8文字以上</p>
          </div>

          <div class="auth-field">
            <%= form.label :password_confirmation, "パスワード（確認）", for: "user-password-confirmation", class: "auth-field__label" %>
            <%= form.password_field :password_confirmation, id: "user-password-confirmation", class: "auth-field__input", autocomplete: "new-password", required: true %>
          </div>
        </div>

        <p class="auth-panel__switch">
          登録前に、<%= link_to "利用規約", terms_path %>と<%= link_to "プライバシーポリシー", privacy_path %>をご確認ください。
        </p>

        <%= form.submit "登録する", class: "button button--primary auth-panel__submit" %>
      <% end %>
      <p class="auth-panel__switch">
        <%= link_to "ログインはこちら", login_path %>
      </p>
    </section>
  </div>
</main>
