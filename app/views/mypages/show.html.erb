<% content_for :title, "マイページ | Shikisai 〜感情の木〜" %>

<div class="tree-page" data-controller="logout-confirmation" data-action="turbo:before-cache@document->logout-confirmation#close">
  <main class="container tree-page__main">
    <header class="tree-page__heading">
      <h1 class="tree-page__title">マイページ</h1>
    </header>

    <ul class="mypage-menu">
      <li>
        <%= link_to "利用規約", terms_path(from: "mypage"), class: "mypage-menu__item" %>
      </li>
      <li>
        <%= link_to "プライバシーポリシー", privacy_path(from: "mypage"), class: "mypage-menu__item" %>
      </li>
      <li>
        <button type="button" class="mypage-menu__item" aria-haspopup="dialog" aria-controls="logout-confirmation" data-action="logout-confirmation#open" data-logout-confirmation-target="trigger">
          ログアウト
        </button>
      </li>
    </ul>

    <dialog id="logout-confirmation" class="logout-dialog" aria-labelledby="logout-confirmation-title" aria-describedby="logout-confirmation-description" data-logout-confirmation-target="dialog" data-action="close->logout-confirmation#restoreFocus">
      <h2 id="logout-confirmation-title" class="logout-dialog__title">ログアウトしますか？</h2>
      <p id="logout-confirmation-description" class="logout-dialog__description">ログアウトすると、TOPページに戻ります。</p>

      <%= form_with url: logout_path, method: :delete, class: "logout-dialog__actions" do %>
        <button type="button" class="button button--secondary" data-action="logout-confirmation#close" autofocus>キャンセル</button>
        <button type="submit" class="button button--primary">ログアウト</button>
      <% end %>
    </dialog>
  </main>

  <%= render "shared/bottom_nav" %>
</div>
