<% content_for :title, "カレンダー | Shikisai 〜感情の木〜" %>

<div class="tree-page">
  <main class="container tree-page__main">
    <header class="tree-page__heading">
      <h1 class="tree-page__title">カレンダー</h1>
      <p id="calendar-description" class="calendar-page__description">一日ごとの感情を、色で振り返る。</p>
    </header>

    <div class="calendar-page__content">
      <table class="calendar-grid" aria-describedby="calendar-description">
        <caption class="calendar-grid__month">
          <span class="calendar-grid__month-navigation">
            <%= link_to calendar_path(month: @month.prev_month.strftime("%Y-%m")), class: "calendar-grid__month-link", aria: { label: "前月を表示" } do %>
              <span aria-hidden="true">‹</span>
            <% end %>
            <time datetime="<%= @month.strftime("%Y-%m") %>"><%= l(@month, format: "%Y年%-m月") %></time>
            <% if @month < Date.current.beginning_of_month %>
              <%= link_to calendar_path(month: @month.next_month.strftime("%Y-%m")), class: "calendar-grid__month-link", aria: { label: "次月を表示" } do %>
                <span aria-hidden="true">›</span>
              <% end %>
            <% else %>
              <span class="calendar-grid__month-link calendar-grid__month-link--disabled" role="link" aria-label="次月は表示できません" aria-disabled="true">
                <span aria-hidden="true">›</span>
              </span>
            <% end %>
          </span>
        </caption>
        <thead>
          <tr>
            <% %w[日 月 火 水 木 金 土].each do |weekday| %>
              <th scope="col"><%= weekday %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% dates = Array.new(@month.wday) + (@month..@month.end_of_month).to_a %>
          <% dates.concat(Array.new((7 - dates.size % 7) % 7)) %>
          <% dates.each_slice(7) do |week| %>
            <tr>
              <% week.each do |day| %>
                <% if day %>
                  <% emotions = @daily_emotions.fetch(day, []) %>
                  <% cell_content = capture do %>
                    <%= time_tag day, day.day, class: "calendar-grid__date" %>
                    <span class="calendar-grid__colors" role="img" aria-label="<%= emotions.empty? ? "感情の色なし" : emotions.map { |emotion| t("emotions.#{emotion.name}") }.join("、") %>">
                      <% emotions.each do |emotion| %>
                        <span class="tree-legend__swatch calendar-grid__swatch" style="background-color: <%= emotion.color_code %>" aria-hidden="true"></span>
                      <% end %>
                    </span>
                  <% end %>
                  <% if day <= Date.current %>
                    <td><%= link_to cell_content, tree_path(date: day.iso8601), class: "calendar-grid__day-link", aria: { label: "#{day.year}年#{day.month}月#{day.day}日の木を見る" } %></td>
                  <% else %>
                    <td class="calendar-grid__future">
                      <span class="calendar-grid__day-link calendar-grid__day-link--disabled" role="link" aria-label="<%= "#{day.year}年#{day.month}月#{day.day}日の木は表示できません" %>" aria-disabled="true"><%= cell_content %></span>
                    </td>
                  <% end %>
                <% else %>
                  <td class="calendar-grid__empty"></td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <ul class="calendar-legend" aria-label="感情の色">
        <% @emotions.each do |emotion| %>
          <li class="calendar-legend__item">
            <span class="tree-legend__swatch" style="background-color: <%= emotion.color_code %>" aria-hidden="true"></span>
            <span><%= t("emotions.#{emotion.name}") %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </main>

  <%= render "shared/bottom_nav" %>
</div>
