<% content_for :title, "カレンダー | Shikisai 〜感情の木〜" %>

<div class="tree-page">
  <main class="container tree-page__main">
    <header class="tree-page__heading">
      <h1 class="tree-page__title">カレンダー</h1>
      <p id="calendar-description" class="calendar-page__description">一日ごとの感情を、色で振り返る。</p>
      <p class="tree-page__notice">表示サンプル</p>
    </header>

    <%# ISSUE 12の固定サンプル。日付計算・実記録の取得や集計は行わない。 %>
    <% emotion_labels = { "happy" => "うれしい", "fun" => "たのしい", "grateful" => "感謝" } %>
    <% sample_days = { 5 => %w[happy], 12 => %w[fun grateful], 19 => %w[happy fun grateful] } %>

    <div class="calendar-page__content">
      <table class="calendar-grid" aria-describedby="calendar-description">
        <caption class="calendar-grid__month"><time datetime="2026-07">2026年7月</time></caption>
        <thead>
          <tr>
            <% %w[日 月 火 水 木 金 土].each do |weekday| %>
              <th scope="col"><%= weekday %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% [nil, nil, nil, *(1..31), nil].each_slice(7) do |week| %>
            <tr>
              <% week.each do |day| %>
                <% if day %>
                  <% emotions = sample_days.fetch(day, []) %>
                  <td>
                    <time class="calendar-grid__date" datetime="2026-07-<%= "%02d" % day %>"><%= day %></time>
                    <span
                      class="calendar-grid__colors"
                      role="img"
                      aria-label="<%= emotions.empty? ? "感情の色なし" : emotions.map { |emotion| emotion_labels.fetch(emotion) }.join("、") %>"
                    >
                      <% emotions.each do |emotion| %>
                        <span class="tree-legend__swatch tree-legend__swatch--<%= emotion %> calendar-grid__swatch" aria-hidden="true"></span>
                      <% end %>
                    </span>
                  </td>
                <% else %>
                  <td class="calendar-grid__empty"></td>
                <% end %>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>

      <ul class="calendar-legend" aria-label="サンプルの感情の色">
        <% emotion_labels.each do |emotion, label| %>
          <li class="calendar-legend__item">
            <span class="tree-legend__swatch tree-legend__swatch--<%= emotion %>" aria-hidden="true"></span>
            <span><%= label %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </main>

  <%= render "shared/bottom_nav" %>
</div>
