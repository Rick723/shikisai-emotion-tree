<% content_for :title, "今日を彩る | Shikisai 〜感情の木〜" %>

<div class="tree-page">
  <main class="container tree-page__main">
    <header class="tree-page__heading">
      <h1 class="tree-page__title">今日を彩る</h1>
      <p class="tree-page__date">
        <%= time_tag @today, l(@today, format: "%Y年%-m月%-d日") %>
      </p>
      <p>いま感じている気持ちを、一つ選んでみましょう。</p>
      <p class="tree-page__notice">入力を試せる表示サンプルです。入力内容は保存されません。</p>
    </header>

    <div class="emotion-form-page__content" data-controller="emotion-input" data-emotion-input-today-value="<%= l(@today, format: "%Y年%-m月%-d日") %>" data-action="turbo:before-cache@document->emotion-input#closeDialog">
      <figure class="tree-visual">
        <div class="tree-visual__layers emotion-form-page__tree" data-emotion-input-target="tree" data-action="pointerup->emotion-input#selectPosition">
          <%= render "shared/tree_base", alt: "淡い緑の基礎木" %>
          <div class="emotion-form-page__preview" data-emotion-input-target="preview" aria-hidden="true" hidden></div>
        </div>
        <button type="button" class="button button--primary emotion-form-page__confirmation-button" data-emotion-input-target="confirmationButton" data-action="emotion-input#openConfirmation" disabled>この位置で確認する</button>
        <figcaption class="auth-field__hint emotion-form-page__caption">
          感情を選び、木の葉をクリック・タップすると仮配置できます。入力内容は保存されません。
        </figcaption>
      </figure>

      <%# 入力状態のみを扱う。form・送信ボタンを置かず、保存リクエストを発生させない。 %>
      <div class="emotion-form">
        <fieldset class="emotion-form__emotions">
          <legend class="auth-field__label">感情の種類</legend>

          <div class="emotion-form__choices">
            <% @emotions.each do |emotion| %>
              <label class="emotion-form__choice">
                <input type="radio" name="emotion" value="<%= emotion.id %>" data-emotion-input-target="emotion" data-emotion-color="<%= emotion.color_code %>" data-emotion-name="<%= t("emotions.#{emotion.name}") %>" data-action="change->emotion-input#updatePreview">
                <span class="tree-legend__swatch" style="background-color: <%= emotion.color_code %>" aria-hidden="true"></span>
                <span><%= t("emotions.#{emotion.name}") %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <div>
          <label for="emotion-strength" class="auth-field__label">感情の強さ</label>
          <input id="emotion-strength" class="emotion-form__range" type="range" min="0" max="100" step="1" value="50" aria-describedby="emotion-strength-hint" data-emotion-input-target="strength" data-action="input->emotion-input#updateStrength">
          <div class="emotion-form__range-labels" aria-hidden="true">
            <span>弱い</span>
            <span>強い</span>
          </div>
          <p id="emotion-strength-hint" class="auth-field__hint">どのくらい強く感じましたか？</p>
          <p class="auth-field__hint">現在の強さ：<output for="emotion-strength" data-emotion-input-target="strengthValue">50</output> / 100</p>
        </div>

        <div>
          <label for="emotion-afterglow" class="auth-field__label">感情の余韻</label>
          <input id="emotion-afterglow" class="emotion-form__range" type="range" min="0" max="100" step="1" value="50" aria-describedby="emotion-afterglow-hint" data-emotion-input-target="afterglow" data-action="input->emotion-input#updateAfterglow">
          <div class="emotion-form__range-labels" aria-hidden="true">
            <span>ほのか</span>
            <span>くっきり</span>
          </div>
          <p id="emotion-afterglow-hint" class="auth-field__hint">いま、どのくらい気持ちが残っていますか？</p>
          <p class="auth-field__hint">現在の余韻：<output for="emotion-afterglow" data-emotion-input-target="afterglowValue">50</output> / 100</p>
        </div>

        <div>
          <label for="emotion-memo" class="auth-field__label">メモ（任意）</label>
          <textarea id="emotion-memo" class="auth-field__input emotion-form__memo" rows="4" maxlength="200" aria-describedby="emotion-memo-hint" data-emotion-input-target="memo"></textarea>
          <p id="emotion-memo-hint" class="auth-field__hint">200文字以内</p>
        </div>
      </div>

      <dialog id="emotion-confirmation" class="emotion-confirmation" aria-labelledby="emotion-confirmation-title" aria-describedby="emotion-confirmation-description" data-emotion-input-target="dialog" data-action="cancel->emotion-input#back close->emotion-input#restoreFocus">
        <h2 id="emotion-confirmation-title" class="emotion-confirmation__title">登録内容を確認</h2>
        <p id="emotion-confirmation-description" class="emotion-confirmation__description">この内容と場所でよろしいですか？入力内容はまだ保存されません。</p>

        <dl class="emotion-confirmation__summary">
          <div>
            <dt>感情</dt>
            <dd data-emotion-input-target="confirmationEmotion"></dd>
          </div>
          <div>
            <dt>感情の強さ</dt>
            <dd><span data-emotion-input-target="confirmationStrength"></span> / 100</dd>
          </div>
          <div>
            <dt>感情の余韻</dt>
            <dd><span data-emotion-input-target="confirmationAfterglow"></span> / 100</dd>
          </div>
          <div>
            <dt>日付</dt>
            <dd data-emotion-input-target="confirmationDate"></dd>
          </div>
          <div>
            <dt>木の位置</dt>
            <dd>仮配置済み</dd>
          </div>
          <div class="emotion-confirmation__memo-row">
            <dt>メモ</dt>
            <dd data-emotion-input-target="confirmationMemo"></dd>
          </div>
        </dl>

        <div class="emotion-confirmation__time">
          <label for="emotion-felt-at" class="auth-field__label">感じた時刻（任意）</label>
          <input id="emotion-felt-at" class="auth-field__input" type="time" data-emotion-input-target="feltAt">
        </div>

        <div class="emotion-confirmation__actions">
          <button type="button" class="button button--secondary" data-emotion-input-target="backButton" data-action="emotion-input#back">戻る</button>
          <button type="button" class="button button--primary" data-action="emotion-input#confirm">この場所に残す</button>
        </div>
      </dialog>
    </div>
  </main>

  <%= render "shared/bottom_nav" %>
</div>
