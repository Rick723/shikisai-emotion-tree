<% content_for :title, "ログイン | Shikisai 〜感情の木〜" %>

<main class="auth-page">
  <div class="container auth-page__container">
    <header class="auth-page__header">
      <p class="site-brand auth-page__brand">
        <span class="site-brand__name">Shikisai</span>
        <span class="site-brand__description">〜感情の木〜</span>
      </p>

      <%= link_to "← 戻る", root_path, class: "auth-page__back" %>
    </header>

    <section class="auth-panel" aria-labelledby="login-title">
      <div class="auth-panel__heading">
        <p class="section-kicker">Log in</p>
        <h1 id="login-title" class="auth-panel__title">ログイン</h1>
      </div>

      <% if @authentication_error %>
        <p role="alert"><%= @authentication_error %></p>
      <% end %>

      <%= form_with url: login_path, scope: :session do |form| %>
        <div class="auth-fields">
          <div class="auth-field">
            <%= form.label :email, "メールアドレス", for: "login-email", class: "auth-field__label" %>
            <%= form.email_field :email, value: @email, id: "login-email", class: "auth-field__input", autocomplete: "email", inputmode: "email", required: true %>
          </div>

          <div class="auth-field">
            <%= form.label :password, "パスワード", for: "login-password", class: "auth-field__label" %>
            <%= form.password_field :password, id: "login-password", class: "auth-field__input", autocomplete: "current-password", required: true %>
          </div>
        </div>

        <%= form.submit "ログイン", class: "button button--primary auth-panel__submit" %>
      <% end %>
      <p class="auth-panel__switch">
        <%= link_to "新規登録はこちら", new_user_path %>
      </p>
    </section>
  </div>
</main>
