# Environment variables
.env
.env.*
!.env.example

# Rails credentials key
/config/master.key
/config/credentials/*.key

# Runtime files
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
!/tmp/pids/
!/tmp/pids/.keep

# Local storage
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/.keep

# Bundler
/.bundle

# OS / editor files
.DS_Store
*.swp
*~

# Keep only placeholder in tmp/pids
/tmp/pids/*
!/tmp/pids/.keep
